SPREADSHEET_ID=replace-me
SESSION_SECRET=replace-me-docker-local
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace-me-base64
APP_ENV=local
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_DEBUG_CODE_IN_RESPONSE=true
# true только для изолированного local/demo. На staging/LAN оставить false.
DISABLE_SYSTEM_PROXY_FOR_GOOGLE=true
