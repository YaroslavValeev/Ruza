APP_ENV=production
SPREADSHEET_ID=your_google_sheet_id
INTAKE_SPREADSHEET_ID=your_canonical_intake_google_sheet_id
INTAKE_TAB_NAME=Ruza

# Choose exactly one credentials option.
# GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON_INLINE={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace_with_base64_service_account_json

SESSION_SECRET=replace_with_long_random_secret
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_NAME=icebeach_session
SESSION_COOKIE_SECURE=true

ALLOW_LEGACY_STAFF_LOGIN=false
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_CODE_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_DEBUG_CODE_IN_RESPONSE=false
ALLOW_MANUAL_OTP_DELIVERY=false
OTP_DELIVERY_WEBHOOK_URL=https://otp-provider.example/send
OTP_DELIVERY_WEBHOOK_TOKEN=replace_with_provider_secret
OTP_DELIVERY_TIMEOUT_SECONDS=8

CORS_ALLOW_ORIGINS=https://dashboard.example.com
CORS_ALLOW_ORIGIN_REGEX=

API_HOST=0.0.0.0
API_PORT=8000
DISABLE_SYSTEM_PROXY_FOR_GOOGLE=true
SHEETS_TAB_CACHE_TTL_SECONDS=15

# Optional Telegram fallback for staff records with telegram_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

AGENTS_SECRET=replace_with_long_random_agents_secret
AGENTS_STAFF_USER_ID=system-agent
AGENTS_API_BASE=http://api:8000
AGENTS_API_TIMEOUT_SECONDS=120
PUBLIC_CLUB_ID=ice_beach_ruza
