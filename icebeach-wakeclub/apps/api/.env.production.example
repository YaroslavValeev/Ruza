APP_ENV=production
SPREADSHEET_ID=your_google_sheet_id

# Choose exactly one credentials option.
# Option 1: mount a JSON file in the container and point to it.
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-service-account.json

# Option 2: paste raw JSON into an env var.
# GOOGLE_SERVICE_ACCOUNT_JSON_INLINE={"type":"service_account",...}

# Option 3: pass base64-encoded JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwuLi59

SESSION_SECRET=replace_with_long_random_secret
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_NAME=icebeach_session
SESSION_COOKIE_SECURE=true

ALLOW_LEGACY_STAFF_LOGIN=false
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_CODE_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_DEBUG_CODE_IN_RESPONSE=false

# Replace with the exact dashboard origin(s) you will use in staging/production.
CORS_ALLOW_ORIGINS=https://dashboard.example.com
# Leave empty to disable regex fallback. Keep LAN regex only for local testing.
CORS_ALLOW_ORIGIN_REGEX=

API_HOST=0.0.0.0
API_PORT=8000
DISABLE_SYSTEM_PROXY_FOR_GOOGLE=true
SHEETS_TAB_CACHE_TTL_SECONDS=15

# Optional OTP via Telegram. Leave empty until the owner rotates secrets and supplies a bot token.
TELEGRAM_BOT_TOKEN=
